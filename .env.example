# SR-OS AutoPost Engine Configuration

# Server Configuration
PORT=8181
NODE_ENV=development

# AutoPost Webhook URL
AUTOPOST_WEBHOOK_URL=https://autopost.superreality.studio/webhook/auto-post

# Folder Paths (optional - defaults provided)
# POSTED_FOLDER=./posted
# LOGS_FOLDER=./logs

# Optional AI API Keys (for advanced caption/hashtag generation)
# OPENAI_API_KEY=your_openai_key_here
# ANTHROPIC_API_KEY=your_anthropic_key_here
